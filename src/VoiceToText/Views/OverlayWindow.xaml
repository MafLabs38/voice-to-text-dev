<Window x:Class="VoiceToText.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dictée universelle"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>
    <StackPanel>
        <Border Background="#DD000000" CornerRadius="6" Padding="10,6" Margin="0,0,0,4"
                Visibility="{Binding ShowRecModule, Converter={StaticResource BoolToVisibility}}"
                MouseLeftButtonDown="RootBorder_MouseLeftButtonDown">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="─" Padding="4,0" Margin="8,0,0,0"
                        Background="Transparent" BorderThickness="0" Foreground="Gray"
                        Click="MinimizeButton_Click" ToolTip="Masquer (dans la zone de notification)" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="RecDot" Width="10" Height="10" Margin="0,0,6,0"
                             Visibility="{Binding IsRecording, Converter={StaticResource BoolToVisibility}}">
                        <Ellipse.Fill>
                            <SolidColorBrush Color="Red" />
                        </Ellipse.Fill>
                        <Ellipse.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         From="1" To="0.15" Duration="0:0:0.6" AutoReverse="True" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>
                    <TextBlock Text="{Binding StatusText}" FontWeight="Bold">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="White" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasError}" Value="True">
                                        <Setter Property="Foreground" Value="#FF6B6B" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Background="#DD000000" CornerRadius="6" Padding="10,6" Width="260"
                Visibility="{Binding ShowLastTranscriptionModule, Converter={StaticResource BoolToVisibility}}"
                MouseLeftButtonDown="RootBorder_MouseLeftButtonDown">
            <StackPanel>
                <TextBox Text="{Binding LastTranscriptionText, Mode=OneWay}"
                         IsReadOnly="True" TextWrapping="Wrap" MaxHeight="120"
                         VerticalScrollBarVisibility="Auto"
                         Background="Transparent" Foreground="White" BorderThickness="0" />
                <Button Content="Copier" HorizontalAlignment="Right" Margin="0,4,0,0"
                        Click="CopyButton_Click" />
            </StackPanel>
        </Border>
    </StackPanel>
</Window>
